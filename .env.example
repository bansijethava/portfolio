# ==============================================================================
# Environment Variables Template
# ==============================================================================
# DO NOT put real keys in this file. This file is safe to commit to GitHub.
# To use your real key:
# 1. Create a local file named ".env.local" in the project root.
# 2. Add: GEMINI_API_KEY=AIzaSy...
# 3. For Vercel, add it under Project Settings -> Environment Variables.
# ==============================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

